/// zerostack Extension API v0.4.0
///
/// WIT contract between zerostack host and Wasm extensions.
///
/// ## v0.4.0 changes (from v0.3.0)
/// - Added `session-control` host import: get/set session name, set terminal title
///
/// ## v0.3.0 changes (from v0.2.0)
/// - Added `trigger-prompt` host import for extensions to inject agent prompts
///
/// ## v0.2.0 changes (from v0.1.0)
/// - Added `extension-context` host import (cwd, session_id, model_name)
/// - Added optional `session-start` and `session-shutdown` exports
/// - Tool/command names are now auto-namespaced as `ext_id__name`

package zerostack:extension@0.4.0;


/// ── shared types ────────────────────────────────────────────

interface types {
    /// Result of an extension tool execution.
    record tool-output {
        content: string,
        details: string,
        is-error: bool,
    }

    /// Context information available to tools and event handlers.
    record extension-info {
        /// Current working directory.
        cwd: string,
        /// Active session identifier (empty string if not in a session).
        session-id: string,
        /// Name of the active model.
        model-name: string,
        /// Whether the current project is trusted.
        project-trusted: bool,
    }
}

/// ── host exports (extension calls into host) ───────────────────

interface tool-registry {
    use types.{tool-output};

    record tool-definition {
        name: string,
        label: string,
        description: string,
        parameters-schema: string,
        prompt-snippet: option<string>,
        prompt-guidelines: list<string>,
    }

    register-tool: func(def: tool-definition) -> result<_, string>;
    unregister-tool: func(name: string) -> result<_, string>;
}

interface command-registry {
    record command-definition {
        name: string,
        description: string,
        argument-hint: option<string>,
    }

    register-command: func(def: command-definition) -> result<_, string>;
    unregister-command: func(name: string) -> result<_, string>;
}


interface trigger-prompt {
    /// Inject a prompt into the agent input queue. The prompt will be
    /// processed as a follow-up message on the next agent turn.
    /// Returns an error string if the prompt couldn't be queued
    /// (e.g., no active session).
    trigger-prompt: func(prompt: string, deliver-as: string) -> result<_, string>;
}

interface extension-context {
    use types.{extension-info};

    /// Retrieve the current extension context. Returns the same data every call
    /// within a single tool execution or event handler.
    get-context: func() -> extension-info;
}

interface session-control {
    /// Get the current session name. Returns empty string if not set.
    get-session-name: func() -> string;

    /// Set the session name. This persists to the session file.
    set-session-name: func(name: string) -> result<_, string>;

    /// Set the terminal window title. The title is restored on session shutdown.
    set-terminal-title: func(title: string);
}

/// ── world: the complete extension contract ─────────────────────

world extension-world {
    import tool-registry;
    import command-registry;
    import extension-context;
    import trigger-prompt;
    import session-control;

    use types.{tool-output};

    /// Called once when the extension is loaded. Must return Ok.
    /// May register tools/commands via the host imports.
    export init: func() -> result<_, string>;

    /// Called when the LLM invokes a tool registered by this extension.
    export tool-execute: func(
        name: string,
        params-json: string,
    ) -> result<tool-output, string>;

    /// Called when the user invokes a slash command registered by this extension.
    export on-command: func(
        name: string,
        args: string,
    ) -> result<string, string>;

    /// Optional. Called when a new session starts (interactive mode only).
    export session-start: func() -> result<_, string>;

    /// Optional. Called when the session is about to shut down (quit, reload, crash).
    export session-shutdown: func() -> result<_, string>;
}
