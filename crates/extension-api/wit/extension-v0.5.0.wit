/// zerostack Extension API v0.5.0
///
/// WIT contract between zerostack host and Wasm extensions.
///
/// ## v0.5.0 highlights
/// - Optional event hooks via dedicated exports:
///     `on-tool-call`, `on-tool-result`, `on-user-bash`,
///     `on-session-before-compact`, `on-session-compacted`,
///     `on-context`, `on-before-agent-start`, `on-input`,
///     `on-message-update`.
/// - `ToolOutput` gains `terminate`, `added-tool-names`, `is-partial`.
/// - `ToolDefinition` gains `execution-mode`, `prepare-arguments-fn`, `truncate`,
///   `added-tool-names-required`, `deferred`.
/// - New host imports:
///     `agent-control`, `ui-prompt`, `ui-status`,
///     `provider-registry`, `exec`, `http`, `file-mutation-queue`,
///     `truncator`, `compaction`, `events-bus`, `permissions`,
///     `resources-discover`.
/// - `trigger-prompt` `deliverAs` is now an enum with three variants:
///     `steer`, `follow-up`, `next-turn`.
/// - Capability gating is enforced at link time: undeclared host imports
///   trap on call instead of running silently.
///
/// ## v0.4.0 → v0.5.0 (breaking)
/// - Package renamed: `zerostack:extension@0.5.0`
/// - `tool-registry.unregister-tool` and `command-registry.unregister-command`
///   no longer accept `result<_, string>` (errors are now host-side warnings).
///
/// ## v0.3.0 → v0.4.0
/// - Added `session-control` host import (get / set session name, terminal title).
/// - Added optional `session-start` and `session-shutdown` exports.
///
/// ## v0.2.0 → v0.3.0
/// - Added `trigger-prompt` host import.

package zerostack:extension@0.5.0;

/// ── shared types ─────────────────────────────────────────────────────

interface types {
    /// Result of an extension tool execution.
    record tool-output {
        content: string,
        details: string,
        is-error: bool,

        /// When true, terminates the agent loop after this tool batch.
        terminate: option<bool>,

        /// Tool names that should be added to the active tool set on the
        /// next LLM request (deferred tool loading).
        added-tool-names: option<list<string>>,

        /// True when the content is a partial / streamed update; the host
        /// should append new content from the next call instead of replacing.
        is-partial: option<bool>,
    }

    /// Modified tool result, the return type of `on-tool-result`.
    record tool-result-patch {
        content: option<string>,
        details: option<string>,
        is-error: option<bool>,
        /// Set to true to drop this tool result entirely.
        drop: option<bool>,
    }

    /// Decision returned by `on-tool-call`. Empty record means "pass through".
    record tool-call-decision {
        /// True to block this tool call.
        block: option<bool>,
        /// Reason shown to the model when blocked.
        reason: option<string>,
        /// New arguments (replaces `input` when set).
        new-input-json: option<string>,
    }

    record extension-info {
        cwd: string,
        session-id: string,
        /// Empty string if no active model.
        model-name: string,
        /// Whether the current project is trusted by the user.
        project-trusted: bool,
        /// Whether the host currently has a TTY available.
        has-ui: bool,
    }

    /// Delivers a trigger-prompt message to one of three channels.
    enum deliver-as {
        /// Steer the in-flight agent turn (mid-run injection).
        steer,
        /// Append to upcoming conversation as a follow-up.
        follow-up,
        /// Queue for the very next user turn.
        next-turn,
    }

    enum execution-mode {
        /// Tool may be invoked in parallel with other parallel tools.
        parallel,
        /// Tool must be invoked sequentially to itself (stateful tools).
        sequential,
    }

    /// Cancel control for events that may be aborted.
    enum cancel-action {
        proceed,
        cancel,
    }

    /// Severity log envelope.
    enum log-level {
        debug,
        info,
        warn,
        error,
    }

    /// Provider description for `provider-registry`.
    record provider-config {
        name: string,
        base-url: option<string>,
        api-key-env: option<string>,
        /// Custom headers merged into every request.
        headers: option<list<tuple<string, string>>>,
        /// Free-form opaque JSON for provider-specific features
        /// (rate limit, completions endpoint, etc.).
        compat: option<string>,
        /// Models offered by this provider.
        models: list<provider-model-config>,
    }

    record provider-model-config {
        id: string,
        display-name: option<string>,
        context-window: option<u32>,
        max-output-tokens: option<u32>,
        /// Native capability flags.
        supports-tools: option<bool>,
        supports-images: option<bool>,
        /// Free-form opaque JSON.
        compat: option<string>,
    }

    /// ExecProcess result.
    record exec-result {
        /// Combined stdout + stderr (UTF-8 lossy).
        output: string,
        exit-code: option<s32>,
        /// True if the process was killed by the host timeout / abort.
        timed-out: option<bool>,
    }

    /// UI dialog option for `ui-prompt.select`.
    record select-option {
        /// Stable identifier (must be unique within the call).
        value: string,
        label: string,
        description: option<string>,
    }
}

/// ── host imports: lifecycle ─────────────────────────────────────────

interface extension-context {
    use types.{extension-info};
    get-context: func() -> extension-info;
}

interface trigger-prompt {
    use types.{deliver-as};
    trigger-prompt: func(prompt: string, deliver-as: deliver-as) -> result<_, string>;
}

interface session-control {
    get-session-name: func() -> string;
    set-session-name: func(name: string) -> result<_, string>;
    set-terminal-title: func(title: string);
}

/// `external-dirs` lets an extension augment the agent's context with
/// directories outside the current working directory. Each added directory
/// contributes its `AGENTS.md`, `CLAUDE.md`, and `<dir>/.agents/skills/*/SKILL.md`
/// (or `SKILLS.md` siblings) into the system prompt on subsequent turns.
///
/// Paths may be relative (resolved against `cwd` from extension-context) or
/// absolute. The host canonicalises, deduplicates, and persists the list to the
/// session file so `/resume` rehydrates the same context.
interface external-dirs {
    /// Add a directory. Returns an error if the path cannot be resolved or is
    /// not a directory.
    add-dir: func(path: string) -> result<_, string>;

    /// Remove a previously-added directory. Returns an error if the path
    /// was not in the list.
    remove-dir: func(path: string) -> result<_, string>;

    /// List all currently-added directories (canonical absolute paths).
    list-dirs: func() -> list<string>;

    /// Check whether a directory is already added.
    has-dir: func(path: string) -> bool;
}

/// ── host imports: registries ─────────────────────────────────────────

interface tool-registry {
    use types.{tool-output, execution-mode};

    record tool-definition {
        name: string,
        label: string,
        description: string,
        /// JSON Schema (draft 2020-12 or 07) describing the parameters.
        parameters-schema: string,
        prompt-snippet: option<string>,
        prompt-guidelines: option<list<string>>,

        /// Default `parallel`. Set to `sequential` for tools that mutate
        /// shared state (e.g. tic-tac-toe, ssh sessions).
        execution-mode: option<execution-mode>,

        /// LLM hint that this tool is part of a deferred tool set and should
        /// only be made available when explicitly requested by the model.
        deferred: option<bool>,
    }

    register-tool: func(def: tool-definition) -> result<_, string>;
    unregister-tool: func(name: string);
}

interface command-registry {
    record command-definition {
        name: string,
        description: string,
        argument-hint: option<string>,
    }

    register-command: func(def: command-definition) -> result<_, string>;
    unregister-command: func(name: string);
}

interface provider-registry {
    use types.{provider-config};
    register-provider: func(cfg: provider-config) -> result<_, string>;
    unregister-provider: func(name: string) -> result<_, string>;
}

/// ── host imports: UI ────────────────────────────────────────────────

interface ui-prompt {
    use types.{select-option};

    /// Show a single-select dialog. Returns the selected `value`, or `""` if cancelled.
    select: func(title: string, options: list<select-option>) -> string;

    /// Ask the user for confirmation. Returns true on Yes, false on No / cancel.
    confirm: func(title: string, message: string) -> bool;

    /// Free-form text input. Returns the entered string, or `""` on cancel.
    input: func(title: string, placeholder: option<string>) -> string;

    /// Show a non-blocking notification.
    notify: func(message: string, level: option<string>);
}

interface ui-status {
    /// Set or clear a status-bar entry. `text = None` clears it.
    set-status: func(key: string, text: option<string>);
    /// Set a widget shown above or below the editor.
    set-widget: func(key: string, lines: option<list<string>>, placement: option<string>);
    /// Set the host terminal title (alias of `session-control.set-terminal-title`).
    set-title: func(title: string);
    /// Push a transient toast (alias of `ui-prompt.notify` with level "info").
    toast: func(message: string);
}

/// ── host imports: agent control ────────────────────────────────────

interface agent-control {
    /// Inject a message into the conversation as `steer` / `follow-up` / `next-turn`.
    send-message: func(text: string, deliver-as: option<string>) -> result<_, string>;
    send-user-message: func(text: string) -> result<_, string>;

    /// Append an entry to the session log (NOT sent to LLM).
    append-entry: func(custom-type: string, data-json: string) -> result<_, string>;

    /// Replace the active model. `name = ""` clears.
    set-model: func(provider: string, name: string) -> result<_, string>;
    get-active-tools: func() -> list<string>;
    set-active-tools: func(names: list<string>) -> result<_, string>;

    /// Compact the current session.
    compact: func(custom-instructions: option<string>) -> result<_, string>;
}

/// ── host imports: capabilities — exec / http ───────────────────────

interface exec {
    use types.{exec-result};
    /// Run a subprocess and return combined stdout+stderr (UTF-8 lossy).
    run: func(command: string, args: list<string>, cwd: option<string>, timeout-ms: option<u32>) -> result<exec-result, string>;
}

interface http {
    /// Synchronous HTTP request, returns body as UTF-8 string.
    request: func(
        method: string,
        url: string,
        headers: option<list<tuple<string, string>>>,
        body: option<string>,
        timeout-ms: option<u32>,
    ) -> result<string, string>;
}

/// ── host imports: file / truncate / session extras ────────────────

interface file-mutation-queue {
    /// Acquire an exclusive lock for `path` and run `callback-id` (opaque
    /// host token returned by the host — the host resolves it back to the
    /// guest's `on-mutation-complete` export).
    with-lock: func(path: string, callback-id: u64) -> result<_, string>;
}

interface truncator {
    /// Truncate a string from the head, keeping the last N bytes.
    truncate-tail: func(content: string, max-bytes: u32) -> string;
    truncate-head: func(content: string, max-bytes: u32) -> string;
    /// Hard cap on a tool output (50 KB / 2 000 lines default).
    cap-output: func(content: string, max-bytes: option<u32>, max-lines: option<u32>) -> string;
}

interface compaction {
    use types.{cancel-action};

    record compaction-decision {
        action: cancel-action,
        /// Optional replacement compaction summary.
        summary: option<string>,
        /// Optional free-form label for `session-tree` indexing.
        label: option<string>,
        /// Skip restoring the prior conversation; jump to a fresh tree leaf.
        skip-conversation-restore: option<bool>,
    }

    /// Query: should we compact now? Returns decision.action == "cancel" to abort.
    before-compact: func(reason: string) -> result<compaction-decision, string>;
    /// Notification: compaction finished (success or cancelled).
    after-compact: func(reason: string, summary: string) -> result<_, string>;
}

/// ── host imports: events, permissions, resources, log ─────────────

interface events-bus {
    /// Subscribe a handler token to event `name`. The host dispatches events
    /// through the guest's `on-event` export. Multiple subscribers allowed.
    subscribe: func(name: string, handler-id: u64) -> result<_, string>;
    unsubscribe: func(name: string, handler-id: u64) -> result<_, string>;
    publish: func(name: string, payload-json: string) -> result<_, string>;
}

interface permissions {
    /// Result of a permission check for `tool` against `pattern`.
    enum verdict {
        allow,
        deny,
        ask,
    }

    check: func(tool: string, pattern: string) -> result<verdict, string>;
    trust-project: func() -> result<bool, string>;
    set-project-trusted: func(trusted: bool) -> result<_, string>;
}

interface resources-discover {
    /// Allow the host to discover additional skill/prompt/theme paths before
    /// they are loaded. Called once per session_start.
    discover: func() -> result<list<tuple<string, string>>, string>;
}

interface logger {
    use types.{log-level};
    log: func(level: log-level, target: string, message: string);
}

/// ── world (the complete contract) ──────────────────────────────────

world extension-world {
    // Host imports (callable from extension)
    import tool-registry;
    import command-registry;
    import extension-context;
    import trigger-prompt;
    import session-control;
    import external-dirs;
    import provider-registry;
    import ui-prompt;
    import ui-status;
    import agent-control;
    import exec;
    import http;
    import file-mutation-queue;
    import truncator;
    import compaction;
    import events-bus;
    import permissions;
    import resources-discover;
    import logger;

    use types.{tool-output, tool-result-patch, tool-call-decision};

    // Core exports (must implement)
    export init: func() -> result<_, string>;
    export tool-execute: func(name: string, params-json: string) -> result<tool-output, string>;
    export on-command: func(name: string, args: string) -> result<string, string>;

    // Lifecycle exports (optional — host detects presence)
    export session-start: func() -> result<_, string>;
    export session-shutdown: func() -> result<_, string>;

    // Event hooks — extension declares what it cares about by exporting these.
    // The host calls them when present; missing exports are silently skipped.

    /// Called BEFORE any tool runs (built-in or extension).
    export on-tool-call: func(
        tool-name: string,
        call-id: string,
        input-json: string,
    ) -> result<tool-call-decision, string>;

    /// Called AFTER a tool result is produced, before the LLM processes it.
    export on-tool-result: func(
        tool-name: string,
        call-id: string,
        input-json: string,
        content: string,
        details: string,
        is-error: bool,
    ) -> result<tool-result-patch, string>;

    /// Called on user `!command` invocations.
    export on-user-bash: func(
        command: string,
        cwd: string,
    ) -> result<string, string>;

    /// Called when a user runs `/name new-name`.
    export on-set-session-name: func(name: string) -> result<bool, string>;

    /// Allow extension to provide a custom compaction summary / cancel.
    export on-session-before-compact: func(reason: string) -> result<string, string>;
    export on-session-compacted: func(reason: string, summary: string) -> result<_, string>;

    /// Called BEFORE the LLM call. Can mutate / replace messages.
    export on-context: func(messages-json: string) -> result<string, string>;

    /// Called after the user submits, before agent_start.
    export on-before-agent-start: func(prompt: string) -> result<string, string>;

    /// Called when raw text input arrives.
    export on-input: func(text: string, source: string) -> result<string, string>;

    /// Called for every assistant message chunk during streaming.
    export on-message-update: func(message-json: string) -> result<_, string>;

    /// Cross-extension event bus dispatcher (handlers are registered through
    /// `events-bus.subscribe` in init).
    export on-event: func(name: string, payload-json: string) -> result<_, string>;

    /// Optional async preparation for arguments; called before tool-execute.
    /// Return either:
    ///   "ok:<json>"   — args are normalized (passed to tool-execute)
    ///   "block:<msg>" — block tool execution with the given reason
    ///   "patch:<json>"— settings to override per-call (currently unused)
    export prepare-arguments: func(name: string, args-json: string) -> result<string, string>;

    /// Async init wrapper (returns once the resource is ready). If absent,
    /// the host treats `init` as fully synchronous.
    export init-async: func() -> result<_, string>;
}
